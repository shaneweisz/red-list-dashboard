# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used by sync scripts only (not exposed to browser)
SUPABASE_SECRET_KEY=your-secret-key

# IUCN Red List API
RED_LIST_API_KEY=your-red-list-api-key

# IUCN Red List PostgreSQL (used by sync-redlist).
# Set DB_HOST/DB_PORT to the server directly if reachable, otherwise tunnel to localhost:5433.
DB_HOST=localhost
DB_NAME=sis
DB_USER=your-user
DB_PASSWORD=your-password

# CITES
SPECIES_PLUS_API_KEY=apikey

# Nosible
NOSIBLE_API_KEY="apikey"

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=apikey
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
SENTRY_AUTH_TOKEN=token

# CloudFlare R2
R2_ACCOUNT_ID=id
R2_ACCESS_KEY_ID=id
R2_SECRET_ACCESS_KEY=key
# Range map / AOH raster storage (scripts/upload-range-maps.ts, upload-aoh-maps.ts)
R2_BUCKET_NAME=bucket
# Dashboard data sync — app/data/ (scripts/upload-data-to-r2.ts, fetch-data-from-r2.ts)
R2_DATA_BUCKET_NAME=dashboard-data

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Langfuse
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
