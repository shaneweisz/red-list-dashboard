# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used by sync scripts only (not exposed to browser)
SUPABASE_SECRET_KEY=your-secret-key

# Gemini AI (for AI search feature)
GEMINI_API_KEY=your-gemini-api-key

# Langfuse LLM observability (optional — omit to disable tracing)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://eu.cloud.langfuse.com  # EU (default) or https://cloud.langfuse.com for US

# IUCN Red List API
RED_LIST_API_KEY=your-red-list-api-key

# IUCN Red List PostgreSQL (used by sync-redlist, via SSH tunnel on port 5433)
DB_HOST=localhost
DB_NAME=sis
DB_USER=your-user
DB_PASSWORD=your-password
