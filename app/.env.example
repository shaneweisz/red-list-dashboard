# IUCN Red List API — assessment-detail tab
RED_LIST_API_KEY=your-red-list-api-key

# Species+ (CITES) API — CITES trade tab
SPECIES_PLUS_API_KEY=your-species-plus-api-key

# IUCN Red List PostgreSQL — used by the data sync pipeline only (fetch-redlist-species).
# Primary: restore the latest ~/Data/RedList/*.bkp into a local Postgres
# (`brew services start postgresql@16` keeps it running across reboots) and
# point at that on the default port. Fallback: SSH-tunnel the remote SIS DB
# to localhost:5433 if you need data newer than your last local restore.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-local-restore-db-name
DB_USER=your-user
DB_PASSWORD=your-password

# CloudFlare R2 — dashboard data sync (app/data/).
# Used by scripts/fetch-data-from-r2.ts (prebuild) and scripts/upload-data-to-r2.ts.
R2_ACCOUNT_ID=id
R2_ACCESS_KEY_ID=id
R2_SECRET_ACCESS_KEY=key
R2_DATA_BUCKET_NAME=dashboard-data

# PostHog analytics (optional, public). Events are reverse-proxied through
# /ingest (see next.config.ts) so the host is fixed there, not via env.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
