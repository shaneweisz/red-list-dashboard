# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used by sync scripts only (not exposed to browser)
SUPABASE_SECRET_KEY=your-secret-key

# IUCN Red List API
RED_LIST_API_KEY=your-red-list-api-key

# IUCN Red List PostgreSQL (used by sync-redlist).
# Set DB_HOST/DB_PORT to the server directly if reachable, otherwise tunnel to localhost:5433.
DB_HOST=localhost
DB_NAME=sis
DB_USER=your-user
DB_PASSWORD=your-password

# CloudFlare R2 — dashboard data sync (app/data/)
# Used by scripts/upload-data-to-r2.ts and scripts/fetch-data-from-r2.ts.
R2_ACCOUNT_ID=id
R2_ACCESS_KEY_ID=id
R2_SECRET_ACCESS_KEY=key
R2_DATA_BUCKET_NAME=dashboard-data
